{
  "name": "nemo-frns-farm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NEMO FRNS FARM - risk-to-earn island life sim for Rare Friends",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "friendsdk dev",
    "dev:lan": "friendsdk dev --host 0.0.0.0",
    "check": "friendsdk check",
    "build": "friendsdk build",
    "build:vite": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "e2e": "node tests/e2e/run.mjs",
    "test:e2e": "npm run build:e2e && npm run e2e",
    "dev:e2e": "vite --mode e2e --host 0.0.0.0",
    "sim": "vitest run tests/economy.sim.test.ts",
    "qa:tour": "node tests/e2e/tour.mjs",
    "qa:panels": "node tests/e2e/panels.mjs"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@rarefriends/friendsdk": "github:rarefriends/friendsdk#c19058711f3c207c67cd30b8136de89978f08ddd",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
