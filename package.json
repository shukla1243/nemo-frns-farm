{
  "name": "nemo-frns-farm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NEMO FRNS FARM - online risk-to-earn island life sim for Rare Friends",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
