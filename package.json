    "nostr-tools": "^2.25.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "trystero": "^0.25.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
